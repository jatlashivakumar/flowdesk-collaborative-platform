NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL — local
DATABASE_URL=postgresql://flowdesk:flowdesk123@localhost:5432/flowdesk_db

# Redis — local
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_super_secret_jwt_key_min_32_chars_here
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_here_too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 (optional — for file uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=flowdesk-uploads

# SMTP Email (optional — use Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@flowdesk.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
